# Copy to .env and fill in real values for local development.
# In staging/production, these are injected by the deploy pipeline after
# being fetched from OCI Vault — never commit real secrets to this file.

SERVICE_NAME=procurement-service
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://procurement:procurement@localhost:5433/procurement_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# Auth
JWT_SECRET_KEY=replace-with-a-strong-secret-from-oci-vault
JWT_ALGORITHM=HS256
JWT_AUDIENCE=nut-meals

# Downstream services
FINANCE_SERVICE_BASE_URL=http://localhost:8020
FINANCE_SERVICE_API_KEY=replace-with-finance-service-api-key

# OCI Vault (used only by the deploy pipeline / bootstrap script, not by the app directly)
OCI_VAULT_ID=
OCI_VAULT_COMPARTMENT_ID=

# Background task tuning
PO_REMINDER_DAYS_BEFORE_DUE=2
INVOICE_RECONCILIATION_INTERVAL_MINUTES=30

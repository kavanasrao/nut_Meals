# ══════════════════════════════════════════════════════════
#  Customer & Commerce Service — Environment Variables
#  Copy to .env and fill in values before running locally.
#  NEVER commit .env to version control.
#  In production, all secrets are fetched from OCI Vault.
# ══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────
APP_NAME=nut_meals-customer-commerce
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
ALLOWED_HOSTS=["*"]

# ── Database (PostgreSQL via asyncpg) ─────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/customer_commerce
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT (shared with Auth Service) ───────────────────────
JWT_SECRET_KEY=CHANGE_ME_USE_OCI_VAULT_IN_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Internal Service URLs ─────────────────────────────────
FINANCE_SERVICE_URL=http://finance-service:8001
NOTIFICATION_SERVICE_URL=http://notification-service:8002

# ── OCI Object Storage (invoice PDFs) ────────────────────
OCI_BUCKET_NAME=nut-meals-invoices
OCI_NAMESPACE=your-tenancy-namespace
OCI_REGION=ap-mumbai-1

# ── GST / Company Details ─────────────────────────────────
COMPANY_NAME=Nut Meals Pvt. Ltd.
COMPANY_GSTIN=27AABCU9603R1ZX
COMPANY_ADDRESS=123, Food Street, Mumbai, Maharashtra - 400001

# ── Abandoned Cart Recovery ───────────────────────────────
ABANDONED_CART_HOURS=24
CART_RECOVERY_CRON_MINUTE=0
CART_RECOVERY_CRON_HOUR=*/6

# ── Invoice Numbering ─────────────────────────────────────
INVOICE_PREFIX=NM-INV
INVOICE_FY_START_MONTH=4        # April (Indian financial year)

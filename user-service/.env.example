# User Service — example environment variables.
# Copy to .env for local development and fill in real values. In
# staging/production these are injected by OCI Vault at deploy time and are
# never committed to source control.

SERVICE_NAME=user-service
ENVIRONMENT=local
DEBUG=true

# --- Database (asyncpg driver required) -------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nutmeals_db

# --- Redis (cache + Celery broker/result backend) ----------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT — shared secret with API Gateway ------------------------------------
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Internal service-to-service auth -----------------------------------------
INTERNAL_SERVICE_TOKEN=change_me_internal

# --- Redis TTL for user profile cache (seconds) -------------------------------
USER_CACHE_TTL=300

# --- Forgot / reset password ---------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_BASE_URL=https://app.nutmeals.com/reset-password

# --- OTP login -------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Google OAuth / Social login --------------------------------------------------
GOOGLE_CLIENT_ID=change_me_google_client_id.apps.googleusercontent.com
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo

# --- Downstream service integrations (internal DNS names in docker-compose) ------
NOTIFICATION_SERVICE_URL=http://notification-service:8003
ORDER_SERVICE_URL=http://order-service:8001
CRM_SERVICE_URL=http://crm-service:8000
SERVICE_HTTP_TIMEOUT_SECONDS=5.0

# --- Security --------------------------------------------------------------------
ENFORCE_HTTPS=false
OCI_VAULT_ENABLED=false
